# Kopieer naar .env en vul in. Zie de README.

# Verplicht: de waarde van het cookie auth-token van twitch.tv.
TWITCH_AUTH_TOKEN=

# Twitch-kanalen, links of namen, gescheiden door komma's. De eerste heeft
# voorrang: drops-makker kijkt altijd naar het eerste kanaal dat live is.
CHANNELS=https://www.twitch.tv/warthunder_esports

# Optioneel: meldingen via een incoming webhook.
MATTERMOST_WEBHOOK=
DISCORD_WEBHOOK=

# Optioneel, met de standaardwaarden:
# POLL_SECONDS=60     hoe vaak kijken of een kanaal live is
# CLAIM_MINUTES=15    hoe vaak de inventaris nalopen tijdens het kijken
# RELOAD_HOURS=3      pagina af en toe vers laden tegen geheugengroei
